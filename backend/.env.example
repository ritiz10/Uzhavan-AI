# Database connection string:
# For MySQL: mysql+pymysql://<user>:<password>@localhost:3306/smart_farming
# For SQLite (default out-of-the-box local testing): sqlite:///./smart_farming.db
DATABASE_URL=sqlite:///./smart_farming.db

# Security
JWT_SECRET=tamil_nadu_smart_farming_super_secret_jwt_key_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / ML
MODEL_DIR=./app/ai/models
UPLOAD_DIR=./uploads

# Weather Provider
# Leave empty or set to 'mock' to use realistic Tamil Nadu agro-climatic mock data
# Or provide your OpenWeatherMap API key
WEATHER_API_KEY=
WEATHER_PROVIDER=mock

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
